<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The direct path is a TCP socket to the host; the HTTP path posts an
         SDP to it. Both need the network and nothing else: no camera, no
         microphone, no storage. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- A game pad is welcome but not required: the on-screen pad is the
         fallback, the same one the page draws. -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false"/>

    <!-- The host speaks plain HTTP on a local network, and Android has
         refused cleartext by default since Android 9. Without this the
         login request fails before it reaches the host, and the app can
         only report what it sees: "login refused", for a password that
         was perfectly good. The direct path is unaffected, being a raw
         socket rather than an HTTP request. -->
    <application
        android:usesCleartextTraffic="true"
        android:label="Capture2Cloud"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Capture2Cloud">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
