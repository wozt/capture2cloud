/*
 * capture2cloud -- what runs where, and what flows between.
 *
 * Rendered with:  dot -Tsvg architecture.dot -o architecture.svg
 *                 dot -Tpng -Gdpi=140 architecture.dot -o architecture.png
 *
 * Drawn from the code rather than from memory: element names are the
 * ones in the GStreamer launch strings in gst_webrtc.c, so a box here
 * can be grepped for there.
 */
digraph capture2cloud {
  rankdir=TB;
  ranksep=0.55;
  nodesep=0.35;
  compound=true;
  bgcolor="#0b1a26";
  fontname="DejaVu Sans";
  fontcolor="#e8f4f8";
  labelloc="t";
  fontsize=22;
  label="capture2cloud — one capture, two encoders, three clients";
  node [fontname="DejaVu Sans", fontsize=11, style="filled,rounded", shape=box,
        color="#2a4a5e", fontcolor="#e8f4f8", penwidth=1.4];
  edge [color="#5c8ba3", fontname="DejaVu Sans", fontsize=9, fontcolor="#9fc4d6",
        penwidth=1.3, arrowsize=0.8];

  /* ---------------- capture ---------------- */
  subgraph cluster_capture {
    label="capture  (video_capture.c, audio_capture.c)";
    fontcolor="#5ce8ff"; color="#1d3646"; style=filled; fillcolor="#0f2431";
    card   [label="V4L2 card\n1920x1080\nYUYV or MJPEG", fillcolor="#123a4d"];
    pulse  [label="PulseAudio\nsource", fillcolor="#123a4d"];
  }

  loop [label="capture loop\ncapture2cloud.c\n\nfeeds a chain only while\nsomeone is on it",
        fillcolor="#1a3d2e", color="#2e7d5b"];

  card -> loop [label="frames"];
  pulse -> loop [label="pcm"];

  /* ---------------- browser chain ---------------- */
  subgraph cluster_browser {
    label="browser stream  —  one VP8 encode, shared";
    fontcolor="#7ff5e4"; color="#1d3646"; style=filled; fillcolor="#0f2431";
    bsrc  [label="appsrc vsrc_vp8\nmax-buffers=1, leaky"];
    bscale[label="videoscale + vscale_caps\n1080 / 720 / 480"];
    benc  [label="vp8enc venc_vp8\nCBR, keyframe every 5 s", fillcolor="#123a4d"];
    btee  [label="tee vtee_vp8", fillcolor="#123a4d"];
    bq    [label="queue  (per client)\nleaky=downstream, 1 s\n\nnon-leaky here stopped\nthe encoder for everyone",
           fillcolor="#3d2a1a", color="#a86b2e"];
    bpay  [label="rtpvp8pay  (per client)\nown SSRC + payload type"];
    bwrtc [label="webrtcbin  (per client)", fillcolor="#123a4d"];
  }

  loop  -> bsrc  [label="only if watchers > 0"];
  bsrc  -> bscale -> benc -> btee -> bq -> bpay -> bwrtc;

  /* ---------------- native chains ---------------- */
  subgraph cluster_native {
    label="native stream  —  two encodes, each fed only on demand";
    fontcolor="#7ff5e4"; color="#1d3646"; style=filled; fillcolor="#0f2431";
    nsrc8   [label="appsrc vsrc_switch"];
    nenc8   [label="vp8enc venc_switch", fillcolor="#123a4d"];
    nsink8  [label="appsink switchsink"];
    nsrc264 [label="appsrc vsrc_switch264"];
    nenc264 [label="vah264enc / x264enc\nvenc_switch_h264", fillcolor="#123a4d"];
    nsink264[label="h264parse + appsink\nswitchsink264"];
  }

  loop -> nsrc8   [label="only if a VP8 client is on"];
  loop -> nsrc264 [label="only if an H.264 client is on"];
  nsrc8   -> nenc8   -> nsink8;
  nsrc264 -> nenc264 -> nsink264;

  /* ---------------- servers ---------------- */
  web  [label="web_stream.c\nHTTP: page, /offer, /login,\n/shared, /quality, /bye",
        fillcolor="#1a3d2e", color="#2e7d5b"];
  ss   [label="switch_stream.c\nbinary TCP 5081\nroutes frames by the\ncodec each client chose",
        fillcolor="#1a3d2e", color="#2e7d5b"];

  nsink8   -> ss [label="VP8 frames"];
  nsink264 -> ss [label="H.264 frames"];

  /* ---------------- clients ---------------- */
  subgraph cluster_clients {
    label="clients";
    fontcolor="#e8b93b"; color="#1d3646"; style=filled; fillcolor="#0f2431";
    browser [label="browser\nweb/*.js\nWebRTC + DataChannel", fillcolor="#2d2436", color="#7a5ea8"];
    android [label="Android app\nMediaCodec", fillcolor="#2d2436", color="#7a5ea8"];
    switchc [label="Switch homebrew\nH.264 only, NVDEC", fillcolor="#2d2436", color="#7a5ea8"];
  }

  bwrtc -> browser [label="RTP / SRTP"];
  web   -> browser [label="page + signalling", style=dashed];
  ss    -> android [label="its codec only"];
  ss    -> switchc [label="H.264"];

  /* ---------------- liveness ---------------- */
  browser -> web [label="X-Client-Id heartbeat\n+ /bye on unload\n\nthe connection state\nnever says a page left",
                  style=dashed, color="#a86b2e", fontcolor="#d89a4e"];

  /* ---------------- input ---------------- */
  subgraph cluster_input {
    label="input  (gamepad_bridge.c, local_pad.c)";
    fontcolor="#e8b93b"; color="#1d3646"; style=filled; fillcolor="#0f2431";
    merge [label="gamepad_bridge\nmerges every source", fillcolor="#3d3320", color="#a8912e"];
    titan [label="Titan One\nlibusb, HID", fillcolor="#3d3320", color="#a8912e"];
    console [label="the console", fillcolor="#123a4d"];
  }

  browser -> merge [label="DataChannel"];
  android -> merge [label="MSG_INPUT"];
  switchc -> merge [label="MSG_INPUT"];
  merge -> titan -> console [label="every 10 ms"];
  console -> card [label="HDMI", style=dashed, color="#5ce8ff"];

  /* ---------------- control ----------------
   * In its own box so it cannot be read as part of the capture: it is
   * the machine's own window, not a source. */
  subgraph cluster_control {
    label="control  (gtk_shell.c)";
    fontcolor="#7fd6a0"; color="#1d3646"; style=filled; fillcolor="#0f2431";
    gtk [label="GTK window\nadmin settings:\ncapture format, resolution,\nbitrate, adapter protocol",
         fillcolor="#1a3d2e", color="#2e7d5b"];
  }
  gtk -> loop [style=dashed, label="applied while running"];
}
