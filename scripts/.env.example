# Capture2Cloud configuration.
#
# Copy this file to `.env` (same directory) and adjust. `.env` is
# git-ignored: it holds real credentials, never commit it.
#
# This single file is read by BOTH the application (app_config.c) and the
# shell scripts, so everything machine-specific lives in one place and
# nothing has to be changed in the source to run on another setup.
# Values may be quoted; `#` starts a comment; the last definition of a
# key wins. It is re-read at runtime, so most changes apply without
# restarting.

# ---------------------------------------------------------------------
# Capture hardware
# ---------------------------------------------------------------------

# V4L2 video device. Prefer a /dev/v4l/by-id/... path: it survives
# /dev/videoN renumbering across reboots and replugs.
# List candidates with:  v4l2-ctl --list-devices
VIDEO_DEVICE=/dev/v4l/by-id/usb-MACROSILICON_USB3_Video_20210623-video-index0

# PulseAudio source for the capture card's audio.
# List candidates with:  pactl list short sources
AUDIO_SOURCE=alsa_input.usb-MACROSILICON_USB3_Video_20210623-02.pro-input-0

# Pixel format read from the capture card.
#
#   yuyv  (default) raw 4:2:2 -- no JPEG decode, and reaching the
#         encoder's I420 is only a chroma subsample. Measured on the
#         reference card at 1080p60: 0.40 ms/frame of CPU versus 7.81 ms
#         for mjpeg, with zero dropped frames over 30 s. Needs real USB3
#         bandwidth (~250 MB/s at 1080p60).
#
#   mjpeg compressed -- far less bandwidth, at the cost of a JPEG decode
#         and a full colour conversion per frame. Use it if the host
#         can't sustain raw throughput: a Raspberry Pi 4, whose USB3 is
#         shared with its Ethernet, is the typical case. Also the
#         fallback if a card doesn't offer yuyv.
CAPTURE_FORMAT=mjpeg

# Play the captured audio on this machine's speakers too (1) or only
# stream it (0). It runs on its own thread either way, so it cannot slow
# the stream down; turning it off just saves a thread and a sound-card
# stream when only the browser matters.
LOCAL_PLAYBACK=1

# ---------------------------------------------------------------------
# Gamepad adapter (optional -- without one, the stream is view-only)
# ---------------------------------------------------------------------

# USB ids of the adapter relaying input to the console. Leave both
# commented out to auto-detect the known ConsoleTuner devices (Titan One,
# Cronus, CronusMAX...). Set BOTH to force a specific device -- useful
# for an adapter this build doesn't know about.
# Find them with:  lsusb     (output is "ID vvvv:pppp")
#GAMEPAD_USB_VID=0x2508
#GAMEPAD_USB_PID=0x0003

# ---------------------------------------------------------------------
# Web streaming
# ---------------------------------------------------------------------

# Port for the built-in web server, and whether it starts automatically
# (1) or waits for the "Stream to browser" menu item (0).
# Changing the port or toggling the stream from the GTK menu applies for
# that session only -- this file is what persists.
WEB_PORT=5080
WEB_AUTOSTART=0

# Port the Switch client connects to. Its own, because the two streams
# are two servers -- the one above is HTTP, this one a small binary
# protocol -- and moving one has no reason to move the other. Changing it
# here or from the settings window means changing it on the console too:
# it is asked for on its own screen.
SWITCH_PORT=5081

# Maximum simultaneous browser clients. Clamped to 32 whatever is set
# here: each client adds its own encoder branch to the live pipeline, so
# an unbounded value would just turn a typo into an out-of-memory.
MAX_CLIENTS=8

# Password required to CONTROL the console from the web page ("log in to
# play"); watching the stream never needs it. Leave empty to let anyone
# take control (no login at all).
PLAYER_PASSWORD=changeme

# ---------------------------------------------------------------------
# Wake-the-console-from-sleep (optional, scripts/wake_console.sh)
# ---------------------------------------------------------------------
# Power-cycles a Home Assistant smart plug: cutting and restoring power
# wakes the console. Only needed if you use that button.

# Home Assistant base URL, no trailing slash.
HA_URL=http://homeassistant.local:8123

# Long-lived access token: Home Assistant -> your profile (bottom-left)
# -> "Long-Lived Access Tokens" -> Create Token.
HA_TOKEN=

# entity_id of the smart plug the console is plugged into.
HA_PLUG_ENTITY=switch.my_console_plug

# Max RTP packet size. "auto" measures the link toward each client and
# sizes that client's packets to fit it -- a viewer arriving over a
# 1280-byte tunnel (Tailscale, WireGuard, most VPNs) gets smaller packets
# than one on the LAN. GStreamer's own default of 1400 does not fit such
# a tunnel, and silently drops every video packet while ICE, DTLS and the
# gamepad channel -- all small packets -- keep working fine.
# Auto-detection only ever lowers the size: it can measure this machine's
# first hop, not the far end's path. Set a number to force one instead.
RTP_MTU=auto

# Frames between forced keyframes (60 fps, so 300 = one every 5s).
# Receivers request one when they need it, so this is only a safety net.
# It was 30 -- two per second -- which made the browser drop 487 frames
# over 230s; at 300 that fell to 203, and past 5s the gain is noise.
KEYFRAME_MAX_DIST=300

# Ne renvoyer un rapport manette que lorsque l'etat change (plus un
# keepalive). La boucle d'envoi tourne sans pause et a ete mesuree a 300
# rapports/s, quasi tous identiques ; si l'adaptateur les accepte plus
# vite que la console ne les consomme, le surplus s'accumule DANS
# l'adaptateur et la latence grandit au fil de la partie. Mettre 0 pour
# retrouver l'ancien comportement (envoi a chaque passe).
GAMEPAD_DEDUP=1
